<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Dados do Projeto"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushBg"       Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BrushCard"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"   Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushLabel"    Color="#646464"/>
        <SolidColorBrush x:Key="BrushValor"    Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"   Color="#D83B01"/>
        <SolidColorBrush x:Key="BrushBranco"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushCancela"  Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BrushLocked"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="BrushOk"       Color="#1B7A3D"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushLabel}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CampoStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="Background" Value="{StaticResource BrushBranco}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource BrushLocked}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushLabel}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource BrushLocked}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Dados do Projeto" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,16"/>

        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="5" Padding="16,14,16,14" Margin="0,0,0,16">
            <StackPanel>

                <!-- Nome do projeto -->
                <TextBlock Text="Nome do projeto" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtNome" Style="{StaticResource CampoStyle}"/>

                <!-- Estado -->
                <TextBlock Text="Estado" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CbEstado" Style="{StaticResource ComboStyle}"
                          SelectionChanged="on_estado_changed">
                    <ComboBoxItem Content="Maranhão"   Tag="MA"/>
                    <ComboBoxItem Content="Pernambuco" Tag="PE"/>
                </ComboBox>

                <Separator Margin="0,0,0,12"/>

                <!-- Área construída -->
                <TextBlock Text="Área construída (m²)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtAreaConstruida" Style="{StaticResource CampoStyle}"/>

                <Separator Margin="0,0,0,12"/>

                <!-- Ocupação principal -->
                <TextBlock Text="Ocupação principal da edificação" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CbOcupacao" Style="{StaticResource ComboStyle}" Margin="0,0,0,0"/>
                <TextBlock Text="Pré-selecionada a divisão mais restritiva (menor distância máxima) entre as existentes na estrutura vinculada."
                           FontSize="10" Foreground="{StaticResource BrushLabel}" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <Separator Margin="0,12,0,12"/>

                <!-- Token de sincronização -->
                <TextBlock Text="Token de sincronização (site → Revit)" Style="{StaticResource LabelStyle}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtToken" Grid.Column="0" FontSize="12" Padding="8,6,8,6"
                             Background="{StaticResource BrushBranco}"/>
                    <Button x:Name="BtnBuscarEstruturas" Grid.Column="2" Content="Buscar"
                            FontSize="11" Padding="10,0,10,0"
                            Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                            BorderThickness="0" Click="on_buscar_estruturas"/>
                </Grid>
                <TextBlock Text="Cole o token do site e clique em Buscar pra carregar as estruturas do projeto. Token em branco = sem sincronização."
                           FontSize="10" Foreground="{StaticResource BrushLabel}" TextWrapping="Wrap"
                           Margin="0,4,0,10"/>

                <!-- Estrutura vinculada -->
                <TextBlock Text="Estrutura vinculada a este arquivo Revit" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CbEstrutura" Style="{StaticResource ComboStyle}" Margin="0,0,0,4"
                          SelectionChanged="on_estrutura_changed"/>

                <TextBlock x:Name="TxtStatusSync" Text="" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushOk}" TextWrapping="Wrap" Margin="0,2,0,0"/>

            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                    Click="on_cancel"/>
            <Button x:Name="BtnSalvar" Content="Salvar" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                    IsDefault="True" Click="on_salvar"/>
        </StackPanel>

    </StackPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Identificar Sinalizações"
        Width="560"
        SizeToContent="Height"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"  Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushLabel"   Color="#646464"/>
        <SolidColorBrush x:Key="BrushValor"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"  Color="#CC1A32"/>
        <SolidColorBrush x:Key="BrushBranco"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushCancela" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BrushWarn"    Color="#B03A2E"/>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushLabel}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Identificar sinalizações" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
        <TextBlock Text="Marque as categorias e escolha o identificador de cada uma. A chamada de detalhe sai na direção da face do elemento, em sentido oposto. Elementos já identificados são pulados."
                   FontSize="11" Foreground="{StaticResource BrushLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="5" Padding="12,10,12,10" Margin="0,0,0,14">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlCategorias"/>
            </ScrollViewer>
        </Border>

        <TextBlock Text="Onde identificar" Style="{StaticResource LabelStyle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="RdoVista" Content="Somente na vista ativa" IsChecked="True"
                         FontSize="12" Margin="0,0,24,0"/>
            <RadioButton x:Name="RdoProjeto" Content="Em todas as vistas de planta do projeto" FontSize="12"/>
        </StackPanel>

        <TextBlock Text="Distância da chamada de detalhe (mm no papel, a partir do centro do elemento)"
                   Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="TxtDistancia" Text="15" Width="100" HorizontalAlignment="Left" Height="28"
                 FontSize="12" Padding="6,0,6,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtStatus" Text="" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushWarn}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                    Click="on_cancel"/>
            <Button Content="Identificar" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                    IsDefault="True" Click="on_ok"/>
        </StackPanel>

    </StackPanel>
</Window>

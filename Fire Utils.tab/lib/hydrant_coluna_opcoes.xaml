<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Inserir Hidrante por Nível"
        Width="340"
        MinHeight="200"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Closing="on_closing">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"  Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushLabel"   Color="#646464"/>
        <SolidColorBrush x:Key="BrushValor"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"  Color="#CC1A32"/>
        <SolidColorBrush x:Key="BrushBranco"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushCancela" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BrushOk"      Color="#1B7A3D"/>
        <SolidColorBrush x:Key="BrushWarn"    Color="#B03A2E"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushLabel}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="NivelCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushValor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botão único de rotação: cada clique avança pra próxima opção
             (ver _ORDEM_DIRECAO/_ORDEM_LADO em hydrant_insert_core.py) —
             só o ícone, quadrado; o valor ATUAL fica num TextBlock ao
             lado (ver TxtDirecaoValor/TxtLadoValor), não dentro do
             botão. -->
        <Style x:Key="RotacaoBotaoStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushBranco}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Content" Value="&#x21BB;"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ValorDirecaoStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushValor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Toggle liga/desliga (CheckBox com template próprio: uma
             "trilha" arredondada + uma "bolinha" que desliza de lado a
             lado conforme IsChecked) — usado pro abrigo de mangueira. -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="20">
                            <Border x:Name="Trilha" CornerRadius="10"
                                    Background="{StaticResource BrushCancela}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"/>
                            <Ellipse x:Name="Bolinha" Width="16" Height="16" Fill="{StaticResource BrushBranco}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Trilha" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Trilha" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Bolinha" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Bolinha" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="22,18,22,18">

        <!-- Botões docked no rodapé: SEMPRE visíveis, mesmo se o
             conteúdo acima crescer além da altura da janela (nesse caso
             o ScrollViewer abaixo rola, o rodapé nunca é empurrado pra
             fora da área visível — era isso que sumia com Cancelar/OK
             ao ligar o abrigo). -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                    Click="on_cancel" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                    IsDefault="True" Click="on_ok"/>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" DockPanel.Dock="Bottom" Text="" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushWarn}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Inserir Hidrante por Nível" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" Margin="0,0,0,16"/>

                <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="5" Padding="16,14,16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Níveis onde inserir hidrante (1 = hidrante único; 2+ = coluna vertical)"
                                   Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PainelNiveis"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="5" Padding="16,14,16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Orientação da válvula e do ramal"
                                   Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnDirecao" DockPanel.Dock="Right"
                                    Style="{StaticResource RotacaoBotaoStyle}" Click="on_direcao_click"/>
                            <TextBlock x:Name="TxtDirecaoValor" Style="{StaticResource ValorDirecaoStyle}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="5" Padding="16,14,16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="ChkAbrigo" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="on_abrigo_changed" Unchecked="on_abrigo_changed"/>
                            <TextBlock Text="Abrigo de mangueira" FontSize="12"
                                       Foreground="{StaticResource BrushValor}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel x:Name="SecaoLadoAbrigo" Margin="0,12,0,0">
                            <TextBlock Text="Lado do abrigo (em relação à válvula)" Style="{StaticResource LabelStyle}"/>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnLado" DockPanel.Dock="Right"
                                        Style="{StaticResource RotacaoBotaoStyle}" Click="on_lado_click"/>
                                <TextBlock x:Name="TxtLadoValor" Style="{StaticResource ValorDirecaoStyle}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FireUtils"
        Width="400"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"  Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushLabel"   Color="#646464"/>
        <SolidColorBrush x:Key="BrushValor"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"  Color="#CC1A32"/>
        <SolidColorBrush x:Key="BrushBranco"  Color="#FFFFFF"/>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,14,22,18">
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtMensagem" Text="" FontSize="12" Foreground="{StaticResource BrushValor}"
                       TextWrapping="Wrap"/>
        </ScrollViewer>
        <Button x:Name="BtnOk" Content="OK" Width="100" Style="{StaticResource BotaoStyle}"
                Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                HorizontalAlignment="Right" Margin="0,18,0,0" IsDefault="True"/>
    </StackPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils"
        Width="460"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <!-- Seletor de ocupação das ferramentas de Saídas (mesmo conteúdo do
         modal da dockpane), em janela própria: dá para usar as ferramentas
         sem deixar a dockpane aberta. Visual igual ao das barras flutuantes. -->
    <Window.Resources>
        <SolidColorBrush x:Key="BrushFundo"  Color="#101014"/>
        <SolidColorBrush x:Key="BrushCard"   Color="#17171C"/>
        <SolidColorBrush x:Key="BrushBorda"  Color="#2C2C33"/>
        <SolidColorBrush x:Key="BrushTexto"  Color="#F5F5F7"/>
        <SolidColorBrush x:Key="BrushSuave"  Color="#87878D"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#C0152A"/>
        <SolidColorBrush x:Key="BrushHover"  Color="#1D1E24"/>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushSuave}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Botão só texto (abre/fecha as notas). -->
        <Style x:Key="BotaoTexto" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushSuave}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Botao" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7,14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campos escuros (o ComboBox/CheckBox padrão do Windows é branco). -->
        <ControlTemplate x:Key="ComboSetaTemplate" TargetType="ToggleButton">
            <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorda}"
                    BorderThickness="1">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Data="M0,0 L4,4 L8,0" Stroke="{StaticResource BrushTexto}" StrokeThickness="1.5"/>
            </Border>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,5,8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Seta" Template="{StaticResource ComboSetaTemplate}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,6,28,6" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorda}"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Caixa" Width="16" Height="16" Background="{StaticResource BrushCard}"
                                    BorderBrush="{StaticResource BrushBorda}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Marca" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{StaticResource BrushAccent}"
                                      StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorda}" BorderThickness="1" Padding="10,6,10,6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuave}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushFundo}" BorderBrush="{StaticResource BrushBorda}"
            BorderThickness="1" CornerRadius="0">
        <DockPanel Margin="18">
            <!-- Rodapé fixo; o miolo rola quando não cabe na altura. -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button x:Name="BtnCancelar" Content="CANCELAR" Style="{StaticResource Botao}"/>
                <Button x:Name="BtnOk" Content="IDENTIFICAR" Style="{StaticResource Botao}"
                        Margin="8,0,0,0" BorderBrush="{StaticResource BrushAccent}"
                        Foreground="{StaticResource BrushAccent}"/>
            </StackPanel>

            <TextBlock x:Name="TxtTitulo" DockPanel.Dock="Top" Text="" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTexto}" Cursor="SizeAll" Margin="0,0,0,8"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtAjuda" Foreground="{StaticResource BrushTexto}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="Ambientes sem estrutura no parâmetro &quot;Estrutura&quot; recebem a estrutura escolhida; os que já têm mantêm a sua."
                               Foreground="{StaticResource BrushSuave}" FontSize="11" TextWrapping="Wrap"/>

                    <TextBlock Text="ESTRUTURA" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CbEstrutura" Padding="6,5,6,5"/>
                    <!-- Grupo e divisão lado a lado (a divisão é a lista de tipos do grupo). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GRUPO" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="CbGrupo" Padding="6,5,6,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DIVISÃO" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="CbTipo" Padding="6,5,6,5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Taxa normativa; só assentos e população estimada pedem um valor
                         (por área, a área vem do ambiente e nada é mostrado). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PainelTaxa" Grid.Column="0">
                            <TextBlock Text="TAXA NORMATIVA" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="CbTaxa" Padding="6,5,6,5"/>
                        </StackPanel>
                        <StackPanel x:Name="PainelValor" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock x:Name="LblValor" Text="ÁREA (M²)" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtValor"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notas retráteis. -->
                    <Button x:Name="BtnNotas" Content="" Style="{StaticResource BotaoTexto}" Margin="0,14,0,0"
                            HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtNotas" Foreground="{StaticResource BrushTexto}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

                    <StackPanel x:Name="PainelNiveis" Visibility="Collapsed">
                        <TextBlock Text="NÍVEIS" Style="{StaticResource Rotulo}"/>
                        <StackPanel x:Name="ListaNiveis"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils"
        Width="220"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        Background="#141414">

    <!-- Barra flutuante modeless de ferramentas: um botão por ferramenta do
         grupo. Os botões são criados em Python (ferramentas_flutuantes.py) a
         partir da definição do grupo, então esta janela serve a qualquer
         grupo futuro (hidrantes, extintores...) sem XAML novo. -->
    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushHover"  Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushBorda"  Color="#333333"/>
        <SolidColorBrush x:Key="BrushTexto"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#E02A3C"/>

        <Style x:Key="BotaoFerramenta" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8,10,8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="10,10,10,4">
        <TextBlock x:Name="TxtTitulo" Text="" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap" Margin="2,0,0,10"/>
        <StackPanel x:Name="Botoes"/>
    </StackPanel>
</Window>

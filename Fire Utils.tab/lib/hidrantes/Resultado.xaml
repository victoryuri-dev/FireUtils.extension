<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Dimensionamento de Hidrantes"
        Width="860" Height="680"
        MinWidth="680" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#121214">

    <Window.Resources>
        <!-- Paleta — identidade Fire Utils (fundo escuro + vermelho de destaque),
             mesma paleta do Carregador de Famílias. BrushOk/BrushOkTint são
             exclusivos desta janela, para o banner de sucesso. -->
        <SolidColorBrush x:Key="BrushBg"         Color="#121214"/>
        <SolidColorBrush x:Key="BrushBg2"        Color="#1C1D21"/>
        <SolidColorBrush x:Key="BrushBg3"        Color="#26272C"/>
        <SolidColorBrush x:Key="BrushBorder"     Color="#34363C"/>
        <SolidColorBrush x:Key="BrushBorder2"    Color="#464850"/>
        <SolidColorBrush x:Key="BrushText"       Color="#F0F0F2"/>
        <SolidColorBrush x:Key="BrushText2"      Color="#A2A5AC"/>
        <SolidColorBrush x:Key="BrushText3"      Color="#70737C"/>
        <SolidColorBrush x:Key="BrushAccent"     Color="#E03A2E"/>
        <SolidColorBrush x:Key="BrushAccentTint" Color="#33E03A2E"/>
        <SolidColorBrush x:Key="BrushOk"         Color="#2FA84F"/>
        <SolidColorBrush x:Key="BrushOkTint"     Color="#332FA84F"/>
        <SolidColorBrush x:Key="BrushInfo"       Color="#3B82F6"/>
        <SolidColorBrush x:Key="BrushInfoTint"   Color="#333B82F6"/>
        <SolidColorBrush x:Key="BrushWhite"      Color="#FFFFFF"/>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="FIRE UTILS   ·   HIDRANTES" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtTitulo" Text="Dimensionamento de Hidrantes" FontSize="22"
                       FontWeight="Light" Foreground="{StaticResource BrushText}"/>
            <TextBlock x:Name="TxtSubtitulo" Text="" FontSize="11"
                       Foreground="{StaticResource BrushText2}" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Banner de status (verde = atende, vermelho = bloqueado) -->
        <Border Grid.Row="1" x:Name="BannerStatus" CornerRadius="6" BorderThickness="1"
                Padding="14,10,14,10" Margin="0,0,0,18">
            <TextBlock x:Name="TxtBanner" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Conteúdo — seções e tabelas montadas em código -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel x:Name="ConteudoPanel"/>
        </ScrollViewer>

        <!-- Rodapé -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnFechar" Content="Fechar" Style="{StaticResource AccentButtonStyle}"
                    Click="on_fechar"/>
        </StackPanel>
    </Grid>
</Window>

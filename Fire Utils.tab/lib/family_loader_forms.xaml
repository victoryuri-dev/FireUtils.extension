<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F6F6F6">

    <!-- Background acima é o mesmo valor de BrushBg abaixo, mas em literal:
         referenciar "{StaticResource BrushBg}" aqui no elemento raiz falha ao
         carregar via XamlReader (pyrevit.forms), porque esse atributo é
         processado antes do bloco Page.Resources (definido como filho, mais
         abaixo no mesmo elemento) existir — StaticResourceExtension não acha
         a chave e a interface cai no formulário padrão do pyRevit. -->
    <Page.Resources>
        <!-- Paleta — identidade Fire Utils light theme (fundo claro + vermelho de destaque).
             Também consumida pelo code-behind (self.Resources["..."]) para os
             cartões/tiles montados dinamicamente. -->
        <SolidColorBrush x:Key="BrushBg"         Color="#F6F6F6"/>
        <SolidColorBrush x:Key="BrushBg2"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBg3"        Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushBorder"     Color="#D9D9D9"/>
        <SolidColorBrush x:Key="BrushBorder2"    Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BrushText"       Color="#333333"/>
        <SolidColorBrush x:Key="BrushText2"      Color="#666666"/>
        <SolidColorBrush x:Key="BrushText3"      Color="#999999"/>
        <SolidColorBrush x:Key="BrushAccent"     Color="#CC1A32"/>
        <SolidColorBrush x:Key="BrushAccentTint" Color="#32CC1A32"/>
        <SolidColorBrush x:Key="BrushWhite"      Color="#FFFFFF"/>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BrushBg}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder2}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AccentOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho — logo + títulos -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="170" Height="48" CornerRadius="8"
                    Background="{StaticResource BrushBg2}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" Margin="0,0,18,0">
                <Grid>
                    <TextBlock x:Name="LogoPlaceholder" Text="LOGO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText3}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="LogoImage" Stretch="Uniform" Margin="10,8,10,8" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="FIRE UTILS   ·   BIBLIOTECA" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
                <TextBlock Text="Carregador de Famílias" FontSize="22" FontWeight="Light"
                           Foreground="{StaticResource BrushText}"/>
                <TextBlock Text="Combate a incêndio — pesquise, filtre por categoria e carregue no projeto"
                           FontSize="11" Foreground="{StaticResource BrushText2}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Busca -->
        <Border Grid.Row="1" Background="{StaticResource BrushBg2}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="18" Padding="14,0,14,0" Height="38" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⌕" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushText3}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid Grid.Column="1">
                    <TextBlock x:Name="PlaceholderBusca" Text="Pesquisar famílias..."
                               Foreground="{StaticResource BrushText3}" FontSize="12"
                               IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBusca" Background="Transparent"
                             Foreground="{StaticResource BrushText}" BorderThickness="0"
                             FontSize="12" VerticalContentAlignment="Center"
                             CaretBrush="{StaticResource BrushText}"
                             TextChanged="on_busca_changed"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Categorias — cabeçalho (rótulo + atualizar) e tiles com ícone -->
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CATEGORIAS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText3}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnAtualizar" Content="↻  Atualizar pasta"
                        FontSize="10" Foreground="{StaticResource BrushAccent}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Cursor="Hand" Click="on_atualizar_pasta"/>
            </Grid>
            <WrapPanel x:Name="TilesPanel" Orientation="Horizontal"/>
        </StackPanel>

        <!-- Catálogo — seções por categoria, cartões em grade (conteúdo montado em código) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel x:Name="ListaPanel"/>
        </ScrollViewer>

        <!-- Status -->
        <TextBlock Grid.Row="4" x:Name="LblStatus" FontSize="11"
                   Foreground="{StaticResource BrushText3}" Margin="0,10,0,10"/>

        <!-- Botões — WrapPanel em vez de duas StackPanels lado a lado: o
             painel de encaixe pode ficar bem mais estreito que a antiga
             janela de 760px, então os botões precisam quebrar linha em vez
             de serem cortados. -->
        <WrapPanel Grid.Row="5" Margin="0,4,0,0" Orientation="Horizontal">
            <Button x:Name="BtnMarcar" Content="Marcar todos (filtrados)" Margin="0,0,8,8"
                    Style="{StaticResource OutlineButtonStyle}" Click="on_marcar_todos"/>
            <Button x:Name="BtnDesmarcar" Content="Desmarcar todos" Margin="0,0,8,8"
                    Style="{StaticResource OutlineButtonStyle}" Click="on_desmarcar_todos"/>
            <Button x:Name="BtnFechar" Content="Fechar" Margin="0,0,8,8"
                    Style="{StaticResource OutlineButtonStyle}" Click="on_fechar"/>
            <Button x:Name="BtnCarregarPosicionar" Content="Carregar e posicionar" Margin="0,0,8,8"
                    Style="{StaticResource AccentOutlineButtonStyle}" Click="on_carregar_posicionar"/>
            <Button x:Name="BtnCarregar" Content="Carregar selecionadas" Margin="0,0,0,8"
                    Style="{StaticResource AccentButtonStyle}" Click="on_carregar"/>
        </WrapPanel>
    </Grid>
</Page>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Gravar Quantitativos"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"  Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushValor"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"  Color="#CC1A32"/>
        <SolidColorBrush x:Key="BrushBranco"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushCancela" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BrushWarn"    Color="#CC1A32"/>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="OpcaoCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushValor}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Gravar quantitativos" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
        <TextBlock Text="Selecione os quantitativos que devem ser coletados do modelo, gravados no firedata.json e enviados pro site."
                   FontSize="11" Foreground="#646464" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="5" Padding="16,14,16,2" Margin="0,0,0,16">
            <StackPanel>
                <!-- Um CheckBox por medida registrada em quantitativos_core.MEDIDAS —
                     x:Name precisa bater com "Chk_" + a chave da medida. -->
                <CheckBox x:Name="Chk_extintores"  Content="Extintores"               Style="{StaticResource OpcaoCheckStyle}"/>
                <CheckBox x:Name="Chk_sinalizacao" Content="Sinalização de Emergência" Style="{StaticResource OpcaoCheckStyle}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="TxtStatus" Text="" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushWarn}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                    Click="on_cancel"/>
            <Button x:Name="BtnOk" Content="Gravar e Enviar" Width="150" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                    IsDefault="True" Click="on_ok"/>
        </StackPanel>

    </StackPanel>
</Window>

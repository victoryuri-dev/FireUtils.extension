<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Inserir Linha com Limite"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Closing="on_closing">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"  Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushLabel"   Color="#646464"/>
        <SolidColorBrush x:Key="BrushValor"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"  Color="#D83B01"/>
        <SolidColorBrush x:Key="BrushBranco"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushCancela" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BrushOk"      Color="#1B7A3D"/>
        <SolidColorBrush x:Key="BrushWarn"    Color="#B03A2E"/>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushLabel}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Inserir linha com limite" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>

        <!-- ===================== ETAPA 1 — configuração ===================== -->
        <StackPanel x:Name="PainelConfig">
            <TextBlock Text="Escolha o estilo da linha e o comprimento máximo do trecho antes de desenhar."
                       FontSize="11" Foreground="{StaticResource BrushLabel}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Estilo da linha" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:Name="CmbEstilo" Height="28" FontSize="12" Margin="0,0,0,14"/>

            <TextBlock Text="Comprimento máximo (m)" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="TxtComprimentoMax" Text="10" Height="28" FontSize="12"
                     Padding="6,4,6,4" Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtErroConfig" Text="" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushWarn}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelarConfig" Content="Cancelar" Width="100" Style="{StaticResource BotaoStyle}"
                        Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                        Click="on_cancelar_config"/>
                <Button x:Name="BtnOk" Content="OK" Width="100" Style="{StaticResource BotaoStyle}"
                        Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                        IsDefault="True" Click="on_ok"/>
            </StackPanel>
        </StackPanel>

        <!-- ===================== ETAPA 2 — acompanhamento ao vivo ===================== -->
        <StackPanel x:Name="PainelRastreio" Visibility="Collapsed">
            <TextBlock Text="A ferramenta Linha de Detalhe do Revit já foi ativada — é só clicar os pontos no estilo escolhido. Este painel acompanha o comprimento total em tempo real."
                       FontSize="11" Foreground="{StaticResource BrushLabel}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="5" Padding="16,14,16,14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Comprimento atual" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="TxtComprimentoAtual" Text="0,00 m" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushValor}" Margin="0,0,0,12"/>
                    <TextBlock Text="Limite configurado" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="TxtLimiteValor" Text="0,00 m" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushLabel}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelarRastreio" Content="Cancelar" Width="90" Style="{StaticResource BotaoStyle}"
                        Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                        Click="on_cancelar_rastreio"/>
                <Button x:Name="BtnFinalizar" Content="Finalizar" Width="90" Style="{StaticResource BotaoStyle}"
                        Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                        Click="on_finalizar"/>
                <Button x:Name="BtnFinalizarLimitar" Content="Finalizar e Limitar" Width="150" Style="{StaticResource BotaoStyle}"
                        Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                        Click="on_finalizar_limitar"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Utils — Conectar Abrigo"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Closing="on_closing">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder"  Color="#D5D5D5"/>
        <SolidColorBrush x:Key="BrushLabel"   Color="#646464"/>
        <SolidColorBrush x:Key="BrushValor"   Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushAccent"  Color="#D83B01"/>
        <SolidColorBrush x:Key="BrushBranco"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushCancela" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BrushOk"      Color="#1B7A3D"/>
        <SolidColorBrush x:Key="BrushWarn"    Color="#B03A2E"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushLabel}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="BotaoStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Opção em formato de botão (RadioButton com template próprio) —
             duas lado a lado por pergunta, clique alterna qual está ativa. -->
        <Style x:Key="OpcaoBotaoStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="6,10,6,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource BrushValor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource BrushBranco}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextBlock.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushBranco}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Preferências de conexão" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,16"/>

        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="5" Padding="16,14,16,14" Margin="0,0,0,16">
            <StackPanel>

                <TextBlock Text="Onde conectar no tubo de referência?" Style="{StaticResource LabelStyle}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <RadioButton x:Name="RbRefCorpo" GroupName="GrupoRef" Margin="0,0,4,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Ponto clicado no corpo (Tê)" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton x:Name="RbRefPonta" GroupName="GrupoRef" Margin="4,0,0,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Ponta livre (se houver)" TextWrapping="Wrap"/>
                    </RadioButton>
                </UniformGrid>

                <TextBlock Text="Lado do ramal (a partir da face do abrigo)" Style="{StaticResource LabelStyle}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <RadioButton x:Name="RbLadoEsquerda" GroupName="GrupoLado" Margin="0,0,4,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Esquerda" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton x:Name="RbLadoDireita" GroupName="GrupoLado" Margin="4,0,0,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Direita" TextWrapping="Wrap"/>
                    </RadioButton>
                </UniformGrid>

                <TextBlock Text="Onde a tubulação deve subir/descer de altura?" Style="{StaticResource LabelStyle}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <RadioButton x:Name="RbAlturaOrigem" GroupName="GrupoAltura" Margin="0,0,4,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Junto à válvula" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton x:Name="RbAlturaDestino" GroupName="GrupoAltura" Margin="4,0,0,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Junto ao tubo de referência" TextWrapping="Wrap"/>
                    </RadioButton>
                </UniformGrid>

                <TextBlock Text="Ordem dos eixos horizontais (X/Y) na rota" Style="{StaticResource LabelStyle}"/>
                <UniformGrid Columns="2">
                    <RadioButton x:Name="RbEixoPadrao" GroupName="GrupoEixo" Margin="0,0,4,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Padrão" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton x:Name="RbEixoInvertido" GroupName="GrupoEixo" Margin="4,0,0,0"
                                 Style="{StaticResource OpcaoBotaoStyle}" Checked="on_opcao_changed">
                        <TextBlock Text="Invertida (troca X/Y)" TextWrapping="Wrap"/>
                    </RadioButton>
                </UniformGrid>
                <TextBlock Text="Padrão: ajusta primeiro o eixo paralelo ao tubo referência. Invertida: ajusta primeiro o eixo perpendicular (pode não ser possível em toda combinação — a prévia avisa)."
                           FontSize="10" Foreground="{StaticResource BrushLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            </StackPanel>
        </Border>

        <TextBlock x:Name="TxtStatus" Text="Pré-visualizando…" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushOk}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushCancela}" Foreground="{StaticResource BrushValor}"
                    Click="on_cancel"/>
            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource BotaoStyle}"
                    Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBranco}"
                    IsDefault="True" Click="on_ok"/>
        </StackPanel>

    </StackPanel>
</Window>

# Copie para .env.local (o Vite carrega .env.local automaticamente e ele já
# está no .gitignore) e preencha com os dados do seu projeto Supabase.
#
# IMPORTANTE: aqui só vai a chave "anon" (pública), NUNCA a service_role —
# a anon key é segura de expor no frontend, o acesso de verdade é
# controlado pelas políticas de RLS configuradas no Supabase.

SUPABASE_URL=https://lngvagifcukglgdjildw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eeyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxuZ3ZhZ2lmY3VrZ2xnZGppbGR3Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njc0NTA3OSwiZXhwIjoyMTAyMzIxMDc5fQ.SLNLZjsk1qJL9kXj1f8143MuAKn5cqlTU9bcWwr8E6c

# Opcional: normalmente não precisa setar isso — por padrão o app monta a
# URL do catalog.json a partir de VITE_SUPABASE_URL
# (<url>/storage/v1/object/public/plugin-assets/catalog.json). Só use se
# quiser apontar pra um catalog.json em outro lugar.
# VITE_CATALOG_URL=

# Opcional: URL base do site (sem barra no final) — usada só pra montar o
# link "abrir no site" no cabeçalho do Dashboard (${VITE_SITE_URL}/${id}
# do projeto) e o botão "Criar novo projeto" da tela "Conectar um
# projeto". Sem isso, os dois simplesmente não aparecem.
# VITE_SITE_URL=

# Opcional: rota do site pra criar um projeto novo (some com VITE_SITE_URL
# na frente). Padrão "/novo" se não setar.
# VITE_SITE_NOVO_PROJETO_PATH=/novo

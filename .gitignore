# Migração pro Supabase (migration/) — credenciais e artefatos gerados
migration/.env
migration/output/

# WebView2 SDK (Fire Utils.tab/lib/webview2_runtime/*.dll) e o build do
# frontend (webapp/dist/) SÃO commitados de propósito, apesar de serem
# binário/artefato gerado — sem CI/CD, é o repositório que alimenta o
# instalador (installer/build.ps1 copia webapp/dist/ para o payload). Se
# não estivessem versionados, gerar o instalador exigiria refazer o
# download do NuGet e o `npm run build` toda vez.

webapp/node_modules/

# Instalador: payload/ é remontado a cada build e output/ guarda o .exe
# gerado (dezenas de MB). Nenhum dos dois entra no repositório.
installer/payload/
installer/output/

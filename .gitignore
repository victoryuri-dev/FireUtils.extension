# Ambiente virtual Python
venv/
.venv/
env/

# Cache Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Configurações e estado local do Claude Code (inclui worktrees internos)
.claude/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.suo
*.user

# Migração pro Supabase (migration/) — credenciais e artefatos gerados
migration/.env
migration/output/

# As DLLs do WebView2 SDK (Fire Utils.tab/lib/webview2_runtime/*.dll) SÃO
# commitadas de propósito, apesar de serem binário de terceiro: sem CI/CD, é
# o repositório que alimenta o instalador, e sem elas instalar numa máquina
# nova exigiria baixar o pacote do NuGet toda vez.

# O build do frontend, ao contrário, não é versionado: a dockpane carrega a
# interface do servidor (ver webapp/README.md), então o dist/ só existe como
# artefato local de quem roda `npm run build` ou `npm run dev`.
webapp/dist/
webapp/node_modules/

# Instalador: payload/ é remontado a cada build, output/ guarda o .exe
# gerado (dezenas de MB) e assets/ são o ícone e as imagens do assistente,
# derivados da logo por scripts/gerar-imagens.ps1. Nenhum dos três entra no
# repositório.
installer/payload/
installer/output/
installer/assets/
